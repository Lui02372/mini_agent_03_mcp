# Copy to env/.env.docker; never commit real passwords or API keys.
POSTGRES_HOST=54.180.29.87
POSTGRES_PORT=5433
POSTGRES_DB=agent_db
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=replace-me
POSTGRES_SSLMODE=prefer
REDIS_HOST=54.180.29.87
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FRONTEND_PORT=80
FRONTEND_BIND_IP=0.0.0.0

# Production: true prevents deployment when the data server is unreachable.
REQUIRE_DATA_SERVICES=false
REDIS_URL=redis://54.180.29.87:6379/0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
WEATHER_AGENT_PROVIDER=ollama
PLACE_AGENT_PROVIDER=ollama
BUDGET_AGENT_PROVIDER=gemma
VALIDATION_AGENT_PROVIDER=gemma

# Separate multi-agent history server; do not replace shared source URLs.
LOG_DATABASE_URL=
LOG_REDIS_URL=

# Dedicated multiagent facts. Set true in production after DB connectivity is verified.
FACTS_DATABASE_URL=
FACTS_REDIS_URL=
REQUIRE_REAL_DATA=false
ENABLE_DEMO=true
MAX_CONCURRENT_RUNS=4

GEMMA_MODEL=gemma3:1b
